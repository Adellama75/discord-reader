[Unit]
Description=discord-reader agent: Discord channel -> Claude Code (chat-agent) -> GitHub issues and replies
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/dev/discord-reader
# claude, gh and uv live in ~/.local/bin; user services don't get a login PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/discord-reader/env
ExecStart=%h/.local/bin/discord-reader agent
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
